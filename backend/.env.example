NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5500
APP_BASE_URL=http://localhost:5500
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riri?schema=public
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback
NOTION_CLIENT_ID=replace-me
NOTION_CLIENT_SECRET=replace-me
